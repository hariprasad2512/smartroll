# Use the same OAuth web client ID configured in frontend/.env.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated faculty Google email addresses. All other verified Google
# accounts self-enroll as students.
FACULTY_EMAILS=faculty@example.edu

# Optional; defaults to a local SQLite database.
# DATABASE_URL=postgresql://user:password@localhost:5432/smartroll
