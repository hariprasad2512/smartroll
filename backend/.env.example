# Use the same OAuth web client ID configured in frontend/.env.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated faculty Google email addresses. All other verified Google
# accounts self-enroll as students.
FACULTY_EMAILS=faculty@example.edu

# For local use, set a PostgreSQL connection URL. The app defaults to SQLite
# when DATABASE_URL is omitted.
# Supabase Session Pooler (port 5432). Replace the password placeholder with
# the URL-encoded password from Supabase. Keep this value private.
# DATABASE_URL=postgresql+psycopg2://postgres.hilydvamoleyykcnvsnk:URL_ENCODED_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
